{
	"layer": "top",
	"modules-left": [
		"sway/workspaces", 
		"sway/mode" 
	],
	"modules-center": [
		"sway/window"
	],
	"modules-right": [
		"tray",
		"pulseaudio",
		"backlight",
		"battery",
		"clock",
		"idle_inhibitor"
	],
	"sway/workspaces": {
		"disable-scroll": true
	},
	"sway/window": {
		"tooltip": false,
		"icon": true,
		"icon-size": 16,
		"max-length": 50
	},
	"idle_inhibitor": {
		"format": "{icon} ",
		"format-icons": {
			"activated": "",
			"deactivated": ""
		}
	},
	"pulseaudio": {
		"tooltip": false,
		"format": "VOL {volume}%",
		"format-muted": "VOL {volume}%"
	},
	"backlight": {
		"tooltip": false,
		"format": "BRI  {percent}%"
	},
	"battery": {
		"tooltip": false,
		"design-capacity": true,

		"states": {
			"warning": 30,
			"critical": 10
		},

		"format": "BAT {capacity}%",
		"format-full": "BAT FULL"
	},
	"clock": {
		"tooltip": true,
		"format": "{:%A %H:%M}",
		"tooltip-format": "{:%A %H:%M %d.%m.%Y}"
	},
	"tray": {
		"spacing": 8
	}
}
